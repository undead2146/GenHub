<UserControl x:Name="Root"
             Focusable="True"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:GenHub.Common.Markup"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:GenHub.Features.Tools.IniEditor.ViewModels"
             x:Class="GenHub.Features.Tools.IniEditor.Views.IniEditorView"
             x:DataType="vm:IniEditorViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocumentCommand}"/>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFolderWithDialogCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenFileWithDialogCommand}"/>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveFileCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveFileAsWithDialogCommand}"/>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  ToolTip.Tip="{localization:Localize Tools.IniEditor.Toolbar.MenuTooltip}"
                  AutomationProperties.Name="{localization:Localize Tools.IniEditor.Toolbar.MenuTooltip}">
            <material:MaterialIcon Kind="Menu" Width="14" Height="14"/>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="{localization:Localize Tools.IniEditor.Toolbar.New}"
                          Command="{Binding NewDocumentCommand}">
                  <MenuItem.Icon>
                    <material:MaterialIcon Kind="Plus" Width="14" Height="14"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{localization:Localize Tools.IniEditor.Toolbar.OpenFolder}"
                          Command="{Binding OpenFolderWithDialogCommand}">
                  <MenuItem.Icon>
                    <material:MaterialIcon Kind="FolderOpen" Width="14" Height="14"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{localization:Localize Tools.IniEditor.Toolbar.OpenFile}"
                          Command="{Binding OpenFileWithDialogCommand}">
                  <MenuItem.Icon>
                    <material:MaterialIcon Kind="FileOutline" Width="14" Height="14"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{localization:Localize Tools.IniEditor.Toolbar.Save}"
                          Command="{Binding SaveFileCommand}"
                          IsEnabled="{Binding HasDocument}">
                  <MenuItem.Icon>
                    <material:MaterialIcon Kind="ContentSave" Width="14" Height="14"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{localization:Localize Tools.IniEditor.Toolbar.SaveAs}"
                          Command="{Binding SaveFileAsWithDialogCommand}"
                          IsEnabled="{Binding HasDocument}">
                  <MenuItem.Icon>
                    <material:MaterialIcon Kind="ContentSaveAll" Width="14" Height="14"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{localization:Localize Tools.IniEditor.Toolbar.Undo}"
                          Command="{Binding UndoCommand}"
                          IsEnabled="{Binding CanUndo}">
                  <MenuItem.Icon>
                    <material:MaterialIcon Kind="Undo" Width="14" Height="14"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{localization:Localize Tools.IniEditor.Toolbar.Redo}"
                          Command="{Binding RedoCommand}"
                          IsEnabled="{Binding CanRedo}">
                  <MenuItem.Icon>
                    <material:MaterialIcon Kind="Redo" Width="14" Height="14"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{localization:Localize Tools.IniEditor.Toolbar.Validate}"
                          Command="{Binding ValidateDocumentCommand}"
                          IsEnabled="{Binding HasDocument}">
                  <MenuItem.Icon>
                    <material:MaterialIcon Kind="Check" Width="14" Height="14"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{localization:Localize Tools.IniEditor.Toolbar.Format}"
                          Command="{Binding FormatDocumentCommand}"
                          IsEnabled="{Binding HasDocument}">
                  <MenuItem.Icon>
                    <material:MaterialIcon Kind="FormatAlignLeft" Width="14" Height="14"/>
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding DocumentTitle}"
                   FontWeight="Bold" FontSize="13"
                   Foreground="{DynamicResource TextPrimary}"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="12,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Command="{Binding AddUpgradeHookupCommand}"
                  Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  ToolTip.Tip="{localization:Localize Tools.IniEditor.Toolbar.AddUpgradeTooltip}"
                  AutomationProperties.Name="{localization:Localize Tools.IniEditor.Toolbar.AddUpgrade}">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <material:MaterialIcon Kind="ArrowUpBoldCircleOutline" Width="14" Height="14"/>
              <TextBlock Text="{localization:Localize Tools.IniEditor.Toolbar.AddUpgrade}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding AddDamageProfileCommand}"
                  Padding="8,4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6"
                  ToolTip.Tip="{localization:Localize Tools.IniEditor.Toolbar.AddDamageTooltip}"
                  AutomationProperties.Name="{localization:Localize Tools.IniEditor.Toolbar.AddDamage}">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <material:MaterialIcon Kind="Flash" Width="14" Height="14"/>
              <TextBlock Text="{localization:Localize Tools.IniEditor.Toolbar.AddDamage}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid ColumnDefinitions="3*,4,4*,4,3*" IsVisible="{Binding HasDocument}">
        <Border Grid.Column="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="8,6" ClipToBounds="True" MinWidth="180">
          <TabControl SelectedIndex="0" Padding="0">
            <TabItem Header="{localization:Localize Tools.IniEditor.Tabs.Blocks}">
              <Grid RowDefinitions="Auto,Auto,*,Auto">
                <TextBox Grid.Row="0"
                         Text="{Binding BlockFilter, Mode=TwoWay}"
                         Watermark="{localization:Localize Tools.IniEditor.Tree.FilterWatermark}"
                         FontSize="11" Margin="0,4,0,4"/>
                <TextBlock Grid.Row="1"
                           Text="{localization:Localize Tools.IniEditor.Tree.Hint}"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,4" TextWrapping="Wrap"/>
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Background="{DynamicResource SurfaceElevatedBrush}">
                  <TreeView ItemsSource="{Binding RootNodes}"
                            SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                            BorderThickness="0" Background="Transparent"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Styles>
                      <Style Selector="TreeViewItem" x:DataType="vm:IniTreeNodeViewModel">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                      </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:IniTreeNodeViewModel">
                        <Border Margin="4,1" Padding="6,3" CornerRadius="6" Background="Transparent" ToolTip.Tip="{Binding DisplayName}" HorizontalAlignment="Stretch">
                          <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource AccentTintBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                              <TextBlock Text="{Binding Badge}"
                                         FontSize="9" FontWeight="SemiBold"
                                         Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                          </Grid>
                        </Border>
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                </Border>
                <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBox Grid.Column="0"
                             Text="{Binding NewBlockName, Mode=TwoWay}"
                             Watermark="{localization:Localize Tools.IniEditor.Tree.NewBlockWatermark}"
                             FontSize="11" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableBlockTypes}"
                              SelectedItem="{Binding NewBlockType, Mode=TwoWay}"
                              MinWidth="120" FontSize="11"/>
                  </Grid>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <Button Command="{Binding AddBlockCommand}"
                            Padding="8,4"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Content="{localization:Localize Tools.IniEditor.Tree.AddBlock}"
                            FontSize="11" FontWeight="SemiBold"/>
                    <Button Command="{Binding DeleteSelectedBlockCommand}"
                            IsEnabled="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Padding="8,4"
                            Background="{DynamicResource StatusErrorBadgeBackgroundBrush}"
                            Foreground="{DynamicResource ErrorBrush}"
                            BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                            CornerRadius="6"
                            Content="{localization:Localize Tools.IniEditor.Tree.Delete}"
                            FontSize="11" FontWeight="SemiBold"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="{localization:Localize Tools.IniEditor.Tabs.Files}">
              <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" Margin="0,4,0,4">
                  <Button Grid.Column="0"
                          Command="{Binding OpenFolderWithDialogCommand}"
                          Padding="8,4"
                          Background="{DynamicResource SurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="6"
                          Content="{localization:Localize Tools.IniEditor.Files.Browse}"
                          FontSize="11" FontWeight="SemiBold"/>
                  <Button Grid.Column="1"
                          Command="{Binding RefreshFilesCommand}"
                          Padding="8,4" Margin="6,0,0,0"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="6"
                          Content="{localization:Localize Tools.IniEditor.Files.Refresh}"
                          FontSize="11"/>
                </Grid>
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Background="{DynamicResource SurfaceElevatedBrush}">
                  <TreeView ItemsSource="{Binding Files}"
                            BorderThickness="0" Background="Transparent"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Styles>
                      <Style Selector="TreeViewItem" x:DataType="vm:IniFileTreeNodeViewModel">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                      </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:IniFileTreeNodeViewModel">
                        <Grid>
                          <Button Command="{Binding ((vm:IniEditorViewModel)DataContext).OpenExplorerFileCommand, ElementName=Root}"
                                  CommandParameter="{Binding}"
                                  IsVisible="{Binding IsDirectory, Converter={x:Static BoolConverters.Not}}"
                                  Background="Transparent" BorderThickness="0"
                                  Padding="6,3" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                              <material:MaterialIcon Grid.Column="0" Kind="FileDocumentOutline" Width="13" Height="13"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Name}"
                                         FontSize="11"
                                         Foreground="{DynamicResource TextPrimary}"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"/>
                            </Grid>
                          </Button>
                          <Button Command="{Binding ((vm:IniEditorViewModel)DataContext).OpenExplorerFileCommand, ElementName=Root}"
                                  CommandParameter="{Binding}"
                                  IsVisible="{Binding IsDirectory}"
                                  Background="Transparent" BorderThickness="0"
                                  Padding="6,3" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                              <material:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="13" Height="13"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Name}"
                                         FontSize="11" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimary}"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"/>
                            </Grid>
                          </Button>
                        </Grid>
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                </Border>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>

        <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

        <Border Grid.Column="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12" ClipToBounds="True" MinWidth="200">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">
              <TextBlock Text="{localization:Localize Tools.IniEditor.Canvas.Title}"
                         FontWeight="Bold" FontSize="14"
                         Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="{localization:Localize Tools.IniEditor.Canvas.Subtitle}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding CanvasSummary}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:IniCanvasSummaryRow">
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,7" Margin="0,0,0,2">
                      <Grid ColumnDefinitions="130,*">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Label}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Value}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="{DynamicResource AccentTintBackgroundBrush}"
                      BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                      CornerRadius="8" Padding="10,8"
                      IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="{localization:Localize Tools.IniEditor.Canvas.EmptySelection}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
              </Border>
              <TextBlock Text="{localization:Localize Tools.IniEditor.Canvas.RawPreview}"
                         FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource TextSecondary}"/>
              <Border BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="8"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Padding="8" MaxHeight="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                  <TextBlock Text="{Binding RawText}"
                             FontFamily="Consolas,Menlo,monospace" FontSize="10"
                             Foreground="{DynamicResource TextPrimary}"
                             TextWrapping="NoWrap"/>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="3" Background="Transparent" ResizeDirection="Columns"/>

        <Border Grid.Column="4"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="8,6" ClipToBounds="True" MinWidth="180">
          <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0"
                       Text="{localization:Localize Tools.IniEditor.Properties.Title}"
                       FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,6"/>
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Background="{DynamicResource SurfaceElevatedBrush}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FieldRows}" Margin="4">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:IniFieldRowViewModel">
                      <Border Padding="6,5" Margin="0,0,0,4" CornerRadius="6"
                              Background="{DynamicResource CardBackground}"
                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                              ToolTip.Tip="{Binding Description}">
                        <Grid RowDefinitions="Auto,Auto">
                          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Key}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    IsVisible="{Binding IsKnown}"
                                    Background="{DynamicResource AccentTintBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                              <material:MaterialIcon Kind="Check" Width="10" Height="10"
                                                     Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                          </Grid>
                          <TextBox Grid.Row="1"
                                   Text="{Binding Value, Mode=TwoWay}"
                                   FontSize="11" Margin="0,4,0,0"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
              <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,6">
                <TextBox Grid.Column="0"
                         Text="{Binding NewFieldKey, Mode=TwoWay}"
                         Watermark="{localization:Localize Tools.IniEditor.Properties.NewKeyWatermark}"
                         FontSize="11" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding NewFieldValue, Mode=TwoWay}"
                         Watermark="{localization:Localize Tools.IniEditor.Properties.NewValueWatermark}"
                         FontSize="11"/>
              </Grid>
              <Button Grid.Row="1"
                      Command="{Binding AddFieldCommand}"
                      Padding="8,4"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="6"
                      Content="{localization:Localize Tools.IniEditor.Properties.AddField}"
                      FontSize="11" FontWeight="SemiBold"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border IsVisible="{Binding HasDocument, Converter={x:Static BoolConverters.Not}}"
              Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="10" Padding="40" MaxWidth="520"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <material:MaterialIcon Kind="FileDocumentEditOutline" Width="40" Height="40"
                                 Foreground="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Center"/>
          <TextBlock Text="{localization:Localize Tools.IniEditor.Empty.Title}"
                     FontWeight="Bold" FontSize="15"
                     Foreground="{DynamicResource TextPrimary}"
                     HorizontalAlignment="Center" TextAlignment="Center"/>
          <TextBlock Text="{localization:Localize Tools.IniEditor.Empty.Message}"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondary}"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Command="{Binding OpenFileWithDialogCommand}"
                    Padding="10,6"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource PrimaryButtonForeground}" BorderThickness="0" CornerRadius="8"
                    Content="{localization:Localize Tools.IniEditor.Empty.OpenFile}"
                    FontSize="11" FontWeight="SemiBold"/>
            <Button Command="{Binding OpenFolderWithDialogCommand}"
                    Padding="10,6"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Content="{localization:Localize Tools.IniEditor.Empty.OpenFolder}"
                    FontSize="11" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
